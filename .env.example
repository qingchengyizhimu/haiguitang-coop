# REST server: safe local-only defaults
REST_HOST=127.0.0.1
REST_PORT=8777

# Local data. Relative paths are resolved from the process working directory;
# absolute paths are recommended for production. Omit these to use ./data/.
# TURTLE_DATA_DIR=./data
# SOUP_DATA_PATH=./data/private/soups.json
# SESSION_DATA_PATH=./data/sessions.json
# ARCHIVE_DATA_PATH=./data/played_games.json

# Provider-agnostic OpenAI Chat Completions-compatible judge
# Keep the key empty until you intentionally configure a model API account.
JUDGE_API_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_TIMEOUT_SECONDS=30

# Legacy DeepSeek compatibility (deprecated; prefer JUDGE_* above).
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_API_KEY=

# MCP server and its REST connection
MCP_HOST=127.0.0.1
MCP_PORT=8778
MCP_REST_API_URL=http://127.0.0.1:8777
TURTLE_ROOM_KEY=haiguitang-main
AI_PLAYER_ID=azhi
MCP_SOURCE=haiguitang-mcp
