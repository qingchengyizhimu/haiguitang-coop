{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "海龟汤题库条目",
  "type": "object",
  "required": ["title", "difficulty", "soup_face", "soup_bottom", "key_elements", "hints", "tags"],
  "properties": {
    "id": {
      "type": "string",
      "description": "稳定且唯一的题目编号，用于去重和游玩记录",
      "examples": ["soup_0001"]
    },
    "title": {
      "type": "string",
      "description": "题名，不得重复"
    },
    "difficulty": {
      "type": "string",
      "enum": ["简单", "中等", "困难"],
      "description": "难度，只能填这三个值"
    },
    "soup_face": {
      "type": "string",
      "description": "玩家开局时看到的内容"
    },
    "soup_bottom": {
      "type": "string",
      "description": "完整真相，只能由后端保存，严禁进前端"
    },
    "key_elements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": "string" },
      "description": "评分关键点，推荐4~6条"
    },
    "hints": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" },
      "description": "阶梯提示，推荐正好3条：第一条给方向，第二条缩小范围，第三条接近关键转折；无提示填[]"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "内容分类，如 抽象、纯逻辑、日常、谐音、动漫"
    },
    "distribution": {
      "type": "string",
      "enum": ["private", "public"],
      "description": "private=仅个人服务器使用；public=可随仓库分发（需确认版权）"
    }
  },
  "additionalProperties": false
}
